# ctxd — configuration
# Copy to .env and fill in. NEVER commit the filled-in .env.

# --- Server-side Metabase (tech team only; end users never see these) ---
METABASE_URL=
METABASE_API_KEY=
METABASE_DATABASE_IDS=
SEMANTIC_DEFINITIONS_FILE=./semantics/definitions.json
CONTEXT_CONTRACT_FILE=./context.contract.json
METABASE_INSTANCE=production
SNAPSHOT_DIR=./snapshots

QUERY_ROW_LIMIT=1000
QUERY_TIMEOUT_MS=15000
DENYLIST=

# --- Hosted connector ---
# Admin dashboard secret (issue per-user tokens at /admin). Generate: npx ctxd token admin-secret
CTXD_ADMIN_TOKEN=
CTXD_DATA_DIR=./data
CTXD_HTTP_HOST=0.0.0.0
CTXD_HTTP_PORT=8787

# Public hostname for Caddy HTTPS (docker compose). Example: ctxd.company.com
CTXD_DOMAIN=localhost
# Let's Encrypt contact email (production HTTPS)
ACME_EMAIL=

# Allow MCP/CLI to execute SQL through Metabase? Default false (context-only).
CTXD_ALLOW_QUERY=false
